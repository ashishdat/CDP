# Production / staging env template for Docker Compose + Helm.
# Copy to .env.production and fill from your secret manager.
# NEVER commit .env.production (gitignored via .env*).
#
#   cp .env.production.example .env.production
#   make docker-prod-up
#
# Fail-closed: CDP_ENV=production rejects sqlite, in-memory bus, and
# default minioadmin credentials. See docs/DOCKER_PRODUCTION.md.

# --- Runtime pin (required) ---
CDP_ENV=production
CDP_PIPELINE_RELEASE=extraction-v3
CDP_RUNTIME_PROFILE=config/runtime_profiles/production_runtime_v1.yaml
PIPELINE_VERSION=0.1.0
SCHEMA_VERSION=1.0
# Baked into cdp-app / cdp-ocr / cdp-routing images
CDP_FIELD_TRUTH=/app/docs/gt/hackathon_agent_field_truth.json

# --- Platform MySQL (compose service `mysql`) ---
MYSQL_DATABASE=idp
MYSQL_USER=idp
MYSQL_PASSWORD=CHANGE_ME_STRONG_PASSWORD
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT_PASSWORD
DATABASE_URL=mysql+pymysql://idp:CHANGE_ME_STRONG_PASSWORD@mysql:3306/idp

# --- Object storage (compose MinIO or real S3) ---
# Must NOT be minioadmin/minioadmin when CDP_ENV=production.
OBJECT_STORE_ENDPOINT=http://minio:9000
OBJECT_STORE_ACCESS_KEY=CHANGE_ME_ACCESS_KEY
OBJECT_STORE_SECRET_KEY=CHANGE_ME_SECRET_KEY
OBJECT_STORE_BUCKET=idp-documents
OBJECT_STORE_USE_SSL=false
OBJECT_STORE_BACKEND=s3
MINIO_ROOT_USER=CHANGE_ME_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_SECRET_KEY

# --- Bus / cache ---
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092
USE_IN_MEMORY_BUS=false
REDIS_URL=redis://redis:6379/0

# --- Ingestion ---
MAX_UPLOAD_SIZE_BYTES=52428800

# --- External AI: fail-closed until BAA / region / PHI approvals ---
VLM_ENABLED=false
AI_GATEWAY_ENABLED=false
AI_PHI_EXTERNAL_PROCESSING_APPROVED=false
AZURE_OPENAI_REVIEW_ONLY=true
AZURE_AI_EVALUATION_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_ENABLED=false
AZURE_DOCUMENT_INTELLIGENCE_AUTHORIZED=false
AZURE_DOCUMENT_INTELLIGENCE_REGION_APPROVED=false
AZURE_DOCUMENT_INTELLIGENCE_PHI_CONTRACT_APPROVED=false
AZURE_DOCUMENT_INTELLIGENCE_REVIEW_ONLY=true

# Optional cloud keys (inject via secret manager only)
# AZURE_OPENAI_ENDPOINT=
# AZURE_OPENAI_API_KEY=
# AZURE_DOCUMENT_INTELLIGENCE_ENDPOINT=
# AZURE_DOCUMENT_INTELLIGENCE_API_KEY=
# ANTHROPIC_API_KEY=

# Image tags for compose.prod (set by make docker-prod-build)
CDP_IMAGE_REGISTRY=
CDP_IMAGE_TAG=latest
