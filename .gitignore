.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
evaluation_results/
.ocr-cache/
build/
dist/

# Evaluation truth, predictions, and reviewer events can contain PHI.
# Keep only the data-handling documentation in source control.
/evaluation_data/*
!/evaluation_data/README.md

# Generated/local bundle executions and scratch reports
/bundle_runs/
/scratchpad_reports/

